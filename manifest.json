{
  "name": "16vibe Assistant",
  "version": "1.0.0",
  "description": "Extension to automate image generation and upload from Google Gemini",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardRead",
    "clipboardWrite",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "*://ecomlap.com/*",
    "*://*.ecomlap.com/*",
    "*://api.16vibe.com/*",
    "*://16vibe.com/*",
    "*://*.16vibe.com/*",
    "*://gemini.google.com/*",
    "*://ai.google.dev/*",
    "*://lh3.googleusercontent.com/*",
    "*://*.googleusercontent.com/*",
    "*://*.amazonaws.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:9000/*",
    "http://127.0.0.1:9000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://ecomlap.com/*",
        "*://*.ecomlap.com/*"
      ],
      "js": [
        "scripts/content/in-page-interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://ecomlap.com/*",
        "*://*.ecomlap.com/*"
      ],
      "js": [
        "scripts/content/product-interceptor.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://ecomlap.com/*",
        "*://*.ecomlap.com/*"
      ],
      "js": [
        "scripts/content/gemini-content.js",
        "scripts/content/link-16vibe-modal.js"
      ],
      "css": [
        "assets/styles/gemini.css",
        "assets/styles/gemini-manager.css",
        "assets/styles/design-ideas-manager.css",
        "assets/styles/link-16vibe-modal.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://gemini.google.com/*",
        "*://ai.google.dev/*"
      ],
      "js": [
        "scripts/content/gemini-content.js"
      ],
      "css": [
        "assets/styles/gemini.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "icons": {
    "16": "assets/images/logo-16.png",
    "128": "assets/images/logo-128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/images/logo-16.png",
      "128": "assets/images/logo-128.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "16vibe Assistant"
  },
  "web_accessible_resources": [
    {
      "resources": [
        ".env",
        "scripts/config.js",
        "scripts/content/in-page-interceptor.js",
        "assets/images/*",
        "assets/styles/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "manifest_version": 3
}